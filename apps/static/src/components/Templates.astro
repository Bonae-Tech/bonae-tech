---
import type { Translations } from '@bonae/content';
import { findTemplateBySlug, templateDetailPath } from '../lib/templates';
import { templateCategoriesFor } from '../lib/templateCategories';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const section = t.templates;
const copy = templateCategoriesFor(t.lang);

const VISIBLE_BULLETS = 3;

const cards = copy.categories.map((category) => {
  const sample = category.sampleSlug ? findTemplateBySlug(t, category.sampleSlug) : undefined;
  const plans = category.plans.map((plan) => ({
    ...plan,
    bullets: [
      ...(plan.features ?? category.features).map((text) => ({ text, included: true })),
      ...(plan.excludedFeatures ?? category.excludedFeatures ?? []).map((text) => ({ text, included: false })),
    ],
  }));
  return { ...category, plans, href: sample ? templateDetailPath(t.lang, sample.slug) : null };
});
---

<section id="plantillas" class="py-20 bg-cream">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-14">
      <span class="inline-block px-3 py-1 rounded-full bg-white text-dark-blue text-xs font-semibold uppercase tracking-wider mb-4 border border-light-blue/20">
        {section.sectionBadge}
      </span>
      <h2 class="section-title">{section.title}</h2>
      <p class="section-subtitle">{section.subheadline}</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 items-stretch">
      {cards.map((card) => (
        <article
          class:list={[
            'relative flex flex-col rounded-2xl bg-white p-7 text-left transition-all duration-200 hover:-translate-y-1 hover:shadow-lg',
            card.featured
              ? 'border-2 border-terracotta shadow-md'
              : 'border border-light-blue/20 shadow-sm',
          ]}
          data-plan-group
        >
          {card.featured && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-terracotta px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white">
              {copy.featuredLabel}
            </span>
          )}

          <div class="mb-4">
            <h3 class="text-xl font-bold text-dark-blue leading-tight mb-2">{card.name}</h3>
            <p class="text-xs font-semibold uppercase tracking-wider text-terracotta">{card.tagline}</p>
          </div>

          <p class="text-sm text-body leading-relaxed mb-5">{card.description}</p>

          <div class="mb-5 pb-5 border-b border-light-blue/20">
            {card.plans.length > 1 ? (
              <div class="inline-flex rounded-lg bg-cream border border-light-blue/25 p-1 mb-3" role="group">
                {card.plans.map((plan, index) => (
                  <button
                    type="button"
                    class="plan-toggle px-4 py-1.5 rounded-md text-sm font-semibold transition-colors cursor-pointer"
                    data-plan-toggle={plan.id}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    {copy.planLabels[plan.id]}
                  </button>
                ))}
              </div>
            ) : (
              <span class="text-sm text-body">{copy.priceLabel}</span>
            )}
            {card.plans.map((plan, index) => (
              <div class:list={{ hidden: index > 0 }} data-plan-price={plan.id}>
                <div class="flex items-baseline gap-2">
                  {plan.originalPrice && (
                    <s class="text-2xl font-semibold text-light-blue decoration-terracotta decoration-2">${plan.originalPrice}</s>
                  )}
                  <span class="text-4xl font-extrabold text-dark-blue">${plan.price}</span>
                  <span class="text-sm font-semibold text-body">{section.priceCurrency}</span>
                </div>
                <span class:list={['text-xs', plan.originalPrice ? 'font-semibold text-terracotta' : 'text-body']}>
                  {plan.originalPrice ? copy.offerNote : section.priceNote}
                </span>
              </div>
            ))}
          </div>

          <div class="flex-1 mb-7">
            {card.plans.map((plan, planIndex) => (
              <div class:list={{ hidden: planIndex > 0 }} data-plan-price={plan.id} data-features>
                <ul class="space-y-2.5">
                  {plan.bullets.map((bullet, index) => (
                    <li
                      class:list={[
                        'flex items-start gap-2.5 text-sm',
                        bullet.included ? 'text-dark-blue' : 'text-body',
                        { hidden: index >= VISIBLE_BULLETS },
                      ]}
                      data-feature-extra={index >= VISIBLE_BULLETS ? '' : undefined}
                    >
                      {bullet.included ? (
                        <svg class="w-5 h-5 shrink-0 text-terracotta" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0z" clip-rule="evenodd" />
                        </svg>
                      ) : (
                        <svg class="w-5 h-5 shrink-0 text-light-blue" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path fill-rule="evenodd" d="M5.3 5.3a1 1 0 0 1 1.4 0L10 8.6l3.3-3.3a1 1 0 1 1 1.4 1.4L11.4 10l3.3 3.3a1 1 0 0 1-1.4 1.4L10 11.4l-3.3 3.3a1 1 0 0 1-1.4-1.4L8.6 10 5.3 6.7a1 1 0 0 1 0-1.4z" clip-rule="evenodd" />
                        </svg>
                      )}
                      <span>{bullet.text}</span>
                    </li>
                  ))}
                </ul>
                {plan.bullets.length > VISIBLE_BULLETS && (
                  <button
                    type="button"
                    class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-terracotta hover:text-terracotta-dark cursor-pointer"
                    aria-expanded="false"
                    data-features-toggle
                    data-label-more={copy.showMoreLabel}
                    data-label-less={copy.showLessLabel}
                  >
                    <span data-features-toggle-label>{copy.showMoreLabel}</span>
                    <svg class="features-chevron w-4 h-4 transition-transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z" clip-rule="evenodd" />
                    </svg>
                  </button>
                )}
              </div>
            ))}
          </div>

          {card.href ? (
            <a
              href={card.href}
              class:list={[
                'inline-flex items-center justify-center w-full px-6 py-3 rounded-lg font-semibold transition-colors',
                card.featured
                  ? 'bg-terracotta text-white hover:bg-terracotta-dark'
                  : 'border-2 border-dark-blue text-dark-blue hover:bg-dark-blue hover:text-white',
              ]}
            >
              {copy.viewTemplateLabel}
            </a>
          ) : (
            <button
              type="button"
              class="inline-flex items-center justify-center w-full px-6 py-3 rounded-lg font-semibold transition-colors border-2 border-dark-blue text-dark-blue hover:bg-dark-blue hover:text-white cursor-pointer"
              data-coming-soon-open
              data-coming-soon-title={card.name}
            >
              {copy.viewTemplateLabel}
            </button>
          )}
        </article>
      ))}
    </div>
  </div>

  <dialog
    id="templates-coming-soon"
    class="max-w-md w-[calc(100%-2rem)] rounded-2xl border-0 p-0 shadow-xl backdrop:bg-dark-blue/45"
  >
    <div class="bg-white rounded-2xl px-8 py-10 text-center">
      <div class="w-14 h-14 rounded-full bg-cream text-terracotta flex items-center justify-center mx-auto mb-5 text-2xl font-light" aria-hidden="true">
        +
      </div>
      <h3 class="text-xl font-bold text-dark-blue mb-3" data-coming-soon-heading>{section.sectionBadge}</h3>
      <p class="text-sm text-body leading-relaxed mb-6">{section.comingSoonModalBody}</p>
      <button
        type="button"
        class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-dark-blue text-white font-semibold hover:bg-dark-blue-dark transition-colors"
        data-coming-soon-close
      >
        {section.comingSoonModalDismiss}
      </button>
    </div>
  </dialog>
</section>

<script>
  const dialog = document.getElementById('templates-coming-soon');
  if (dialog instanceof HTMLDialogElement) {
    const heading = dialog.querySelector('[data-coming-soon-heading]');
    document.querySelectorAll<HTMLElement>('[data-coming-soon-open]').forEach((el) => {
      el.addEventListener('click', () => {
        if (heading && el.dataset.comingSoonTitle) heading.textContent = el.dataset.comingSoonTitle;
        dialog.showModal();
      });
    });
    document.querySelectorAll('[data-coming-soon-close]').forEach((el) => {
      el.addEventListener('click', () => dialog.close());
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-plan-group]').forEach((group) => {
    const toggles = group.querySelectorAll<HTMLButtonElement>('[data-plan-toggle]');
    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const planId = toggle.dataset.planToggle;
        toggles.forEach((t) => t.setAttribute('aria-pressed', String(t === toggle)));
        group.querySelectorAll<HTMLElement>('[data-plan-price]').forEach((price) => {
          price.classList.toggle('hidden', price.dataset.planPrice !== planId);
        });
      });
    });
  });

  document.querySelectorAll<HTMLElement>('[data-features]').forEach((block) => {
    const toggle = block.querySelector<HTMLButtonElement>('[data-features-toggle]');
    const label = toggle?.querySelector('[data-features-toggle-label]');
    if (!toggle || !label) return;
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(expanded));
      label.textContent = (expanded ? toggle.dataset.labelLess : toggle.dataset.labelMore) ?? '';
      block.querySelectorAll('[data-feature-extra]').forEach((item) => {
        item.classList.toggle('hidden', !expanded);
      });
    });
  });
</script>

<style>
  .plan-toggle {
    color: var(--color-body);
  }
  .plan-toggle[aria-pressed='true'] {
    background-color: var(--color-dark-blue);
    color: #fff;
  }
  [aria-expanded='true'] .features-chevron {
    transform: rotate(180deg);
  }
</style>
