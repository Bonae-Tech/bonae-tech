---
import type { MetaLandingCopy } from '../../lib/metaLanding';
import { metaLandingPaths } from '../../lib/metaLanding';

interface Props {
  copy: MetaLandingCopy;
  whatsappHref: string;
}

const { copy, whatsappHref } = Astro.props;
const paths = metaLandingPaths(copy.lang);
const deviceSrc = '/images/meta/bonae-site-preview.png';
---

<div class="meta-lp__strip">{copy.urgencyStrip}</div>

<header class="meta-lp__shell py-4 flex items-center justify-between gap-4">
  <div class="flex items-center gap-2" aria-label="BONAE TECH">
    <img src="/favicon.png" alt="" class="w-9 h-9" width="36" height="36" />
    <span class="font-display font-bold text-dark-blue text-xl tracking-tight">BONAE TECH</span>
  </div>
  <span class="hidden sm:inline text-xs font-semibold uppercase tracking-wider text-terracotta">Meta Ads</span>
</header>

<main class="pb-28 md:pb-16">
  <section class="meta-lp__shell">
    <div class="meta-lp__hero-grid">
      <div>
        <h1 class="meta-lp__headline">{copy.headline}</h1>
        <p class="meta-lp__lead">{copy.subheadline}</p>
        <ul class="meta-lp__checklist">
          {copy.heroBullets.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <a
          href={whatsappHref}
          class="meta-lp__cta-main meta-wa-link"
          data-meta-wa
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {copy.primaryCta}
        </a>
        <p class="meta-lp__cta-note">{copy.ctaNote}</p>
      </div>

      <div class="meta-lp__device" aria-hidden="false">
        <div class="meta-lp__device-frame">
          <div class="meta-lp__device-notch"></div>
          <img src={deviceSrc} alt={copy.deviceImageAlt} width="640" height="800" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="meta-lp__shell">
    <h2 class="text-center font-display text-2xl font-bold text-dark-blue mb-2">{copy.priceSectionTitle}</h2>
    <p class="text-center text-sm text-body mb-6">{copy.priceFootnote}</p>
    <div class="meta-lp__price-row">
      {copy.priceCards.map((card) => (
        <article class:list={['meta-lp__price-card', card.highlight && 'meta-lp__price-card--hot']}>
          {card.highlight && <span class="meta-lp__price-badge">{copy.popularBadge}</span>}
          <p class="text-sm font-semibold text-mid-blue mb-2">{card.label}</p>
          <p class="meta-lp__price-value">{card.price}</p>
          <p class="text-xs text-body mt-2">{card.note}</p>
        </article>
      ))}
    </div>
    <div class="text-center -mt-4 mb-8">
      <a
        href={whatsappHref}
        class="meta-lp__cta-main meta-wa-link inline-flex"
        data-meta-wa
        target="_blank"
        rel="noopener noreferrer"
      >
        {copy.primaryCta}
      </a>
    </div>
  </section>

  <section class="meta-lp__shell">
    <div class="meta-lp__panel">
      <h2 class="font-display text-2xl font-bold mb-2">{copy.panelTitle}</h2>
      <p class="text-light-blue text-sm mb-2">{copy.panelLead}</p>
      <div class="meta-lp__steps">
        {copy.steps.map((step, index) => (
          <div>
            <span class="meta-lp__step-num">{index + 1}</span>
            <h3 class="font-bold mb-1">{step.title}</h3>
            <p class="text-sm text-light-blue leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <footer class="meta-lp__footer meta-lp__shell">
    <p>
      <a href={paths.templates} class="text-mid-blue font-semibold underline underline-offset-2">
        {copy.siteLinkLabel}
      </a>
    </p>
    <p class="mt-2">
      <a href={paths.privacy} class="underline underline-offset-2">{copy.legalNote}</a>
    </p>
  </footer>
</main>

<div class="fixed bottom-0 inset-x-0 p-3 bg-white border-t border-light-blue/25 shadow-lg md:hidden z-40">
  <a
    href={whatsappHref}
    class="meta-lp__cta-main w-full meta-wa-link"
    data-meta-wa
    target="_blank"
    rel="noopener noreferrer"
  >
    {copy.primaryCta}
  </a>
</div>

<script>
  function enrichWhatsAppLinks() {
    const params = new URLSearchParams(window.location.search);
    const ref =
      params.get('utm_campaign') ||
      params.get('utm_content') ||
      params.get('fbclid')?.slice(0, 24) ||
      '';
    if (!ref) return;
    document.querySelectorAll<HTMLAnchorElement>('a[data-meta-wa]').forEach((a) => {
      try {
        const url = new URL(a.href);
        const text = url.searchParams.get('text');
        if (text && !text.includes('(ref:')) {
          url.searchParams.set('text', `${text} (ref: ${ref})`);
          a.href = url.toString();
        }
      } catch {
        /* ignore */
      }
    });
  }
  enrichWhatsAppLinks();
</script>
